DATABASE_URL=postgres://postgres:devpass@localhost:5432/stockagents
DATABASE_URL_TEST=postgres://postgres:devpass@localhost:5432/stockagents_test

DATA_STALENESS_MINUTES=90
EVENT_LOG_RETENTION_DAYS=90

# true: phiên tự động hằng ngày (data-service) chạy --stub, không tốn token
# thật — bật khi chưa có đủ API key cho mọi provider.
SIM_STUB=false

DATABASE_URL_READONLY=postgres://stockagents_ro:readonly@localhost:5432/stockagents
DATABASE_URL_READONLY_TEST=postgres://stockagents_ro:readonly@localhost:5432/stockagents_test

DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
DASHBOARD_TOKEN=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Model dùng cho agent điều phối (npm run telegram-bot) — vai trò tư vấn/tổng
# hợp, khác 5 agent giao dịch đang so sánh, nên mặc định dùng model mạnh hơn
# thay vì Haiku. Bỏ trống thì dùng mặc định anthropic/claude-sonnet-5.
COORDINATOR_PROVIDER=
COORDINATOR_MODEL=
